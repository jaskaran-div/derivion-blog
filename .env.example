# Public Express API origin (no trailing slash).
NEXT_PUBLIC_NEWSLETTER_API_URL=https://blog-backend-bwup.onrender.com

# The article sidebar also reads GET /api/market/snapshot from this origin (server-side, revalidated every 5 minutes).

# News & Insights also merges automated posts from GET /api/auto-news/posts on this origin
# (server-side, revalidated every 5 minutes, so new posts appear without a rebuild).
# Optional: restrict next/image to your Cloudinary account (server-side only, not NEXT_PUBLIC).
CLOUDINARY_CLOUD_NAME=
